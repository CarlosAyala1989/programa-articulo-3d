# Copia este archivo fuera del repositorio y agrega las claves por entorno seguro.
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_PLANNER=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_PLANNER_FALLBACK=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_CODE_REVIEWER=poolside/laguna-xs-2.1
NVIDIA_MODEL_VISUAL_REVIEWER=moonshotai/kimi-k3
NVIDIA_MODEL_GENERATOR=deepseek-ai/deepseek-v4.1-flash
NVIDIA_MODEL_TEXT_JUDGE=z-ai/glm-5.3
# Cosmos no apareció en el catálogo asociado a la clave consultada; queda deshabilitado.
NVIDIA_MODEL_VISUAL_REASONER=
# Solo activa este interruptor para un protocolo separado que permita métricas de referencia.
QUALITY_ALLOW_REFERENCE_METRICS=0
MAXIMO_LLAMADAS_QUALITY_LOOP=40
MAXIMO_TOKENS_QUALITY_LOOP=800000
MAXIMO_TOKENS_SALIDA_QUALITY_GENERADOR=32768
